{
  "name": "python-workbench",
  "displayName": "Python Workbench",
  "description": "Run selected Python code using uv directly from VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",

"contributes": {
  "commands": [
    {
      "command": "uv-python-runner.runSelection",
      "title": "UV Python Runner: Run Selection"
    }
  ],
  "menus": {
    "editor/context": [
      {
        "command": "uv-python-runner.runSelection",
        "when": "editorLangId == python && editorHasSelection",
        "group": "navigation"
      }
    ]
  },
  "keybindings": [
    {
      "command": "uv-python-runner.runSelection",
      "key": "ctrl+alt+enter",
      "when": "editorLangId == python && editorHasSelection"
    }
  ]
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
